{
  "manifest_version": 3,
  "name": "Simple AdBlock",
  "version": "1.2.0",
  "description": "Blocks common ads and skips community-reported YouTube sponsor segments.",
  "permissions": [
    "declarativeNetRequest",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://sponsor.ajay.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ads",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "action": {
    "default_title": "Simple AdBlock",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "youtube.js",
        "sponsorblock.js"
      ],
      "css": [
        "youtube.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
